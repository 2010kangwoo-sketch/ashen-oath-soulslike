{
  "name": "ashen-oath-soulslike",
  "private": true,
  "version": "1.0.0-rc.4",
  "type": "module",
  "description": "A compact, release-targeted browser 3D soulslike built with Three.js and Rapier.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run build && node tools/verify-production-pass13.mjs",
    "start": "vite --host 127.0.0.1 --open"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
